NODE_ENV=development
PORT=3000

# Usa secretos aleatorios distintos de al menos 32 caracteres.
SESSION_SECRET=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Solo durante una rotación; elimínala cuando los tokens ya se hayan re-cifrado.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
JWT_EXPIRES_IN=15m
JWT_ISSUER=darkhub-twitch-backend
JWT_AUDIENCE=twitch-backend-api

MONGO_URL=mongodb://localhost:27017/twitchbot

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL=http://localhost:3000/auth/twitch/callback
TWITCH_BROADCASTER_ID=
TWITCH_BROADCASTER_LOGIN=
EXTRA_MOD_IDS=

FRONTEND_URL=http://localhost:5173
PUBLIC_URL=
SWAGGER_ENABLED=true
TUNNEL_MODE=false
EVENTSUB_SECRET=
INTERNAL_API_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://localhost:3000/spotify/callback
SONG_REQUEST_COST=1000

RENDER_SERVICE_ID=
RENDER_API_KEY=

# Integraciones privadas de bots. Los tokens nunca se exponen en VITE_*.
# Déjalo en false. Usa true únicamente para una red privada HTTP confiable.
BOT_ALLOW_INSECURE_HTTP=false
TTS_BOT_URL=http://localhost:3001
# Mismo valor que PANEL_API_TOKEN en TTSBOT.
TTS_BOT_PANEL_TOKEN=
# Mismo valor que ADMIN_TOKEN en TTSBOT; solo para control administrativo.
TTS_BOT_ADMIN_TOKEN=
RISITAS_BOT_URL=http://localhost:8080
# Produccion: RISITAS_BOT_URL=https://risitas-bot.onrender.com
# Mismo valor que API_KEY en Risitas; copiar la existente, no rotarla por accidente.
RISITAS_BOT_API_KEY=
